# Server-only KijaniSpace credentials. Never expose these through NEXT_PUBLIC_* variables.
KIJANISPACE_API_BASE_URL=https://api.kijanispace.eu
KIJANISPACE_USERNAME=
KIJANISPACE_PASSWORD=

# API service
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000

# Browser application
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
